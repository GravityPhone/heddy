# Copy this file to .env and fill in your keys. Never commit the real .env file.

# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Optional integrations --------------------------------------------------
# A Zapier "Catch Hook" URL. When set, the assistant gets a send_text_message
# tool that posts {"text": "..."} to this URL. Treat the URL as a secret.
#ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# --- Assistant --------------------------------------------------------------
# Any OpenAI model that supports the Responses API and image input.
#HEDDY_MODEL=gpt-4.1-mini
# System prompt. The default asks for short, speakable answers.
#HEDDY_INSTRUCTIONS=
#HEDDY_MAX_OUTPUT_TOKENS=300
# Seconds of silence after which the conversation context is dropped.
#HEDDY_CONVERSATION_TIMEOUT=90

# --- Speech -----------------------------------------------------------------
#ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
#ELEVENLABS_MODEL_ID=eleven_turbo_v2
# Must be a pcm_<sample rate> format (higher rates may need a paid ElevenLabs tier).
#ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# --- Hardware ---------------------------------------------------------------
#HEDDY_CAMERA_DEVICE=/dev/video0

# --- Diagnostics ------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR
#HEDDY_LOG_LEVEL=INFO
